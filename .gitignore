# 本仓库直接位于小狼毫的安装目录 D:\Rime 下。
# weasel-0.17.4 是已安装的小狼毫本体（第三方二进制），不属于本仓库内容。
weasel-0.17.4/
weasel-0.17.4-backup-*/
RimeUser/

# 构建产物
out/
output/
dist/
msbuild/
build/
*.obj
*.pdb
*.ilk
*.iobj
*.ipdb
*.exp
*.lib
*.exe
*.dll
*.pch
*.ipch
*.tlog
*.log

# 编译中间目录
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*~

# 编辑器
.vs/
.vscode/
.idea/
*.user
*.suo

# reference/ 是第三方源码快照，忽略其自带的版本控制残留
reference/**/.git/
reference/**/.github/

# 编译前提的小体积导入库保留在仓库中（各约 0.3 MB / 10 KB）。
# 否定规则必须写在上面 *.lib / *.def / *.exp 之后才会生效。
#   build-libs/ = librime 导入库
#   lib/  lib64/ = WinSparkle 导入库（由 WinSparkle.dll 的导出表生成）
!src/build-libs/*.lib
!src/build-libs/*.def
!src/build-libs/*.exp
!src/lib/WinSparkle.lib
!src/lib64/WinSparkle.lib
!src/lib/WinSparkle.def
!src/lib64/WinSparkle.def


